{
  "name": "sandbox",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "browserslist": [
    "iOS >= 15",
    "Safari >= 15",
    "Chrome >= 109",
    "ChromeAndroid >= 109",
    "Firefox >= 115",
    "Edge >= 109",
    "Samsung >= 21"
  ],
  "scripts": {
    "browserstack:audio:all:android": "RUN_ALL_PARKS_SOAK=1 browserstack-node-sdk playwright test tests/audio-all-parks-mobile.spec.ts",
    "browserstack:audio:worst:android": "browserstack-node-sdk playwright test tests/audio-worst-case-mobile.spec.ts",
    "browserstack:path:android": "browserstack-node-sdk playwright test tests/path-replay.spec.ts",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "audio:check": "bash scripts/check-audio-variants.sh",
    "audio:convert:wav": "bash scripts/convert-m4a-to-wav-safari.sh",
    "audio:convert:flac": "bash scripts/convert-wav-to-flac.sh",
    "demo:wayfinding": "PLAYWRIGHT_VIDEO=1 WAYFINDING_HOLD_MS=2500 playwright test tests/wayfinding.spec.ts --project=chromium -g \"counts a park as heard\"",
    "demo:calmer": "PLAYWRIGHT_VIDEO=1 REDUCE_VISUALS_HOLD_MS=2500 playwright test tests/reduce-visuals.spec.ts --project=chromium",
    "test:e2e:video": "PLAYWRIGHT_VIDEO=1 playwright test --project=chromium",
    "test:e2e:prod": "vite build && playwright test -c playwright.prod.config.ts",
    "test:e2e": "playwright test tests/map-camera.spec.ts tests/park-selection.spec.ts tests/prefetch-proximity.spec.ts tests/gimbal-math.spec.ts tests/approach-ring.spec.ts tests/path-replay.spec.ts tests/geolocation-status.spec.ts tests/permission-states.spec.ts tests/geofence-hysteresis.spec.ts tests/audio-unlock.spec.ts tests/silent-phone-hint.spec.ts tests/wayfinding.spec.ts tests/overlay-layer.spec.ts tests/chatham-site.spec.ts tests/reduce-visuals.spec.ts tests/accessibility.spec.ts --project=chromium",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --ext js,mjs,cjs,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "sim:path": "playwright test tests/path-replay.spec.ts --project=chromium --headed",
    "sim:path:iphone": "playwright test tests/path-replay.spec.ts --project=iphone-13 --headed",
    "sim:path:pixel": "playwright test tests/path-replay.spec.ts --project=pixel-7 --headed",
    "sim:path:https:iphone": "PLAYWRIGHT_EXTERNAL_SERVER=1 playwright test tests/path-replay.spec.ts --project=iphone-13 --headed",
    "sim:path:https:pixel": "PLAYWRIGHT_EXTERNAL_SERVER=1 playwright test tests/path-replay.spec.ts --project=pixel-7 --headed",
    "sim:audio:all:iphone": "RUN_ALL_PARKS_SOAK=1 playwright test tests/audio-all-parks-mobile.spec.ts --project=iphone-13 --headed",
    "sim:audio:all:pixel": "RUN_ALL_PARKS_SOAK=1 playwright test tests/audio-all-parks-mobile.spec.ts --project=pixel-7 --headed",
    "sim:audio:all:https:iphone": "RUN_ALL_PARKS_SOAK=1 PLAYWRIGHT_EXTERNAL_SERVER=1 playwright test tests/audio-all-parks-mobile.spec.ts --project=iphone-13 --headed",
    "sim:audio:all:https:pixel": "RUN_ALL_PARKS_SOAK=1 PLAYWRIGHT_EXTERNAL_SERVER=1 playwright test tests/audio-all-parks-mobile.spec.ts --project=pixel-7 --headed",
    "sim:walk:iphone": "PATH_REPLAY_PAUSE=1 playwright test tests/path-replay.spec.ts --project=iphone-13 --headed",
    "sim:walk:https:iphone": "PATH_REPLAY_PAUSE=1 PLAYWRIGHT_EXTERNAL_SERVER=1 playwright test tests/path-replay.spec.ts --project=iphone-13 --headed",
    "sim:turn:iphone": "PATH_REPLAY_FILE=tests/paths/sica-hollow-turning-walk.json PATH_REPLAY_PAUSE=1 playwright test tests/path-replay.spec.ts --project=iphone-13 --headed",
    "sim:turn:https:iphone": "PATH_REPLAY_FILE=tests/paths/sica-hollow-turning-walk.json PATH_REPLAY_PAUSE=1 PLAYWRIGHT_EXTERNAL_SERVER=1 playwright test tests/path-replay.spec.ts --project=iphone-13 --headed",
    "sim:audio:worst:iphone": "playwright test tests/audio-worst-case-mobile.spec.ts --project=iphone-13 --headed",
    "sim:audio:worst:pixel": "playwright test tests/audio-worst-case-mobile.spec.ts --project=pixel-7 --headed",
    "sim:audio:worst:https:iphone": "PLAYWRIGHT_EXTERNAL_SERVER=1 playwright test tests/audio-worst-case-mobile.spec.ts --project=iphone-13 --headed",
    "sim:audio:worst:https:pixel": "PLAYWRIGHT_EXTERNAL_SERVER=1 playwright test tests/audio-worst-case-mobile.spec.ts --project=pixel-7 --headed",
    "sim:ring": "APPROACH_RING_HOLD_MS=8000 playwright test tests/approach-ring.spec.ts --project=chromium --headed",
    "sim:ring:iphone": "APPROACH_RING_HOLD_MS=8000 playwright test tests/approach-ring.spec.ts --project=iphone-13 --headed",
    "sim:path:install": "playwright install chromium webkit",
    "render:sites": "tsx scripts/dump-placements.ts && python3 scripts/render-site-layout.py"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "@heroicons/react": "^2.1.1",
    "@turf/boolean-point-in-polygon": "^6.5.0",
    "@turf/helpers": "^6.5.0",
    "ol": "^8.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.13",
    "resonance-audio": "^1.0.0",
    "rlayers": "^2.2.0"
  },
  "devDependencies": {
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.59.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.2.33",
    "@types/react-dom": "^18.2.14",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@welldone-software/why-did-you-render": "^8.0.1",
    "autoprefixer": "^10.4.17",
    "browserstack-node-sdk": "^1.52.0",
    "eslint": "^8.52.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.34",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
